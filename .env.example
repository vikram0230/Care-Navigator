# OpenAI (optional until RAG stages; required for embeddings/LLM)
OPENAI_API_KEY=

# Redis — cache, Celery broker/backend
REDIS_URL=redis://redis:6379/0

# ChromaDB server (HTTP API)
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Multi-tenant company IDs (comma-separated)
COMPANY_IDS=acme_corp,globex_inc

# Logging / environment
LOG_LEVEL=INFO
ENVIRONMENT=development
