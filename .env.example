# Google Gemini (AI Studio) — required for embeddings / LLM in RAG stages
GEMINI_API_KEY=
# Optional overrides (defaults are sensible for dev)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Free tier: ~100 embed HTTP calls/minute; one large PDF can exceed that without pacing.
# EMBEDDING_SUB_BATCH_SIZE=50
# EMBEDDING_INTER_BATCH_DELAY_SECONDS=0.7
# EMBEDDING_RATE_LIMIT_MAX_RETRIES=12

# Redis — cache, Celery broker/backend
REDIS_URL=redis://redis:6379/0

# ChromaDB (HTTP). For ``python scripts/seed_documents.py`` and pytest on your machine,
# point at the published port (docker-compose maps container 8000 -> host 8001):
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Note: Docker Compose sets CHROMA_HOST=chromadb / port 8000 for api, worker, and streamlit
# in docker-compose.yml, so those containers ignore these values when overridden there.

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Multi-tenant company IDs (comma-separated)
COMPANY_IDS=bcbs,wells_fargo

# Logging / environment
LOG_LEVEL=INFO
ENVIRONMENT=development
