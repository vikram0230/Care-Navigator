# Ollama — embeddings + chat for ingest and RAG (pull models after first start).
#
# Where the API runs matters:
# - API on your machine (uvicorn): use http://localhost:11434 and run ``brew services start ollama``
#   (or the Ollama app). Confirm: curl http://localhost:11434/api/tags
# - API in Docker Compose: ``docker-compose.yml`` pins the API/worker/streamlit containers to
#   ``http://ollama:11434`` so a host-only value like ``http://localhost:11434`` in this file does
#   not break in-network calls. Pull models in the container:
#     docker exec -it care-navigator-ollama ollama pull nomic-embed-text
#   Homebrew Ollama on the Mac does NOT fix a containerized API unless you point the API at the
#   host (e.g. OLLAMA_BASE_URL=http://host.docker.internal:11434) and avoid port 11434 conflicts
#   with the compose ``ollama`` service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2

# Embedding ingest pacing (optional; gentle load on local Ollama)
# EMBEDDING_SUB_BATCH_SIZE=50
# EMBEDDING_INTER_BATCH_DELAY_SECONDS=0.2

# RAG retrieval (``POST /rag/query``)
# RAG_TIER1_TOP_K=6
# RAG_TIER2_TOP_K=6
# RAG_MAX_CONTEXT_CHUNKS=12
# Stage 4: comma-separated tokens; when set, callers must send Authorization: Bearer <token> or X-API-Key
# RAG_API_KEYS=

# Stage 5: Redis exact-match answer cache + embedding cache (fails open if Redis is unreachable)
# RAG_ANSWER_CACHE_ENABLED=true
# RAG_ANSWER_CACHE_TTL_SECONDS=3600
# RAG_EMBEDDING_CACHE_ENABLED=true
# RAG_EMBEDDING_CACHE_TTL_SECONDS=86400

# Stage 6: async ingest (POST /ingest/upload, POST /ingest/reseed, GET /ingest/status/{task_id}).
# Separate key space from RAG_API_KEYS since ingest is a write/admin capability.
# INGEST_API_KEYS=
# INGEST_UPLOAD_DIR must be a directory both the api and celery-worker containers can read; Compose
# mounts a shared ``uploads_data`` volume at /app/data/uploads for both. For host-run scripts/tests,
# a repo-relative folder like ``data/uploads`` (created on first upload) is fine.
# INGEST_UPLOAD_DIR=data/uploads
# INGEST_MAX_UPLOAD_MB=25
# INGEST_WEBHOOK_TIMEOUT_SECONDS=5.0

# Stage 7: conversation memory threaded into POST /rag/query's LLM prompt. A non-empty
# conversation_history in the request always bypasses the Stage 5 answer cache.
# RAG_MAX_CONVERSATION_TURNS=6

# Stage 7: Streamlit UI (ui/app.py). API_BASE_URL is where the browser-facing UI reaches the
# API (Compose sets this to http://api:8000; for `streamlit run ui/app.py` on the host, point
# it at http://localhost:8000). STREAMLIT_RAG_API_KEY / STREAMLIT_INGEST_API_KEY are single
# tokens the UI attaches automatically as X-API-Key on every request — set each to one of the
# comma-separated values in RAG_API_KEYS / INGEST_API_KEYS respectively when those are
# configured; leave blank when they're unset (the local dev default). There is no key input
# field in the UI itself.
# API_BASE_URL=http://localhost:8000
# STREAMLIT_RAG_API_KEY=
# STREAMLIT_INGEST_API_KEY=

# Redis — cache, Celery broker/backend. The ``redis`` hostname only resolves inside the Compose
# network; running scripts/seed_documents.py directly on the host (like the CHROMA_HOST note
# below), set REDIS_URL=redis://localhost:6379/0 so its post-ingest cache invalidation can reach it
# (it fails open and just skips invalidation if Redis isn't reachable).
REDIS_URL=redis://redis:6379/0

# ChromaDB (HTTP). For ``python scripts/seed_documents.py`` and pytest on your machine,
# point at the published port (docker-compose maps container 8000 -> host 8001):
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Note: Docker Compose sets CHROMA_HOST=chromadb / port 8000 for api, worker, and streamlit
# in docker-compose.yml, so those containers ignore these values when overridden there.

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Multi-tenant company IDs (comma-separated)
COMPANY_IDS=bcbs,wells_fargo

# Logging / environment
LOG_LEVEL=INFO
ENVIRONMENT=development
